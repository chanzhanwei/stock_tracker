# Copy to .env.local for `vercel dev`. Never commit real keys.

# Clerk email one-time-code sign-in.
# Production without these keys does not skip the allowlist.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional. Used only if Clerk's allowlist cannot store adds.
# Either pair is read:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
